<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    app:cardBackgroundColor="#1E1E30"
    app:cardCornerRadius="24dp"
    app:cardElevation="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Emoji + Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvPopupEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="36sp"
                android:layout_marginEnd="14dp"/>

            <TextView
                android:id="@+id/tvPopupTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Threat description -->
        <TextView
            android:id="@+id/tvPopupThreat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            android:background="#22FF4444"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Tips label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIPS"
            android:textColor="#4400E5FF"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:layout_marginBottom="6dp"/>

        <!-- Tips container (filled programmatically) -->
        <LinearLayout
            android:id="@+id/llPopupTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginBottom="20dp"/>

        <!-- Open Settings button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPopupProceed"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Open Settings"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#00E5FF"
            android:layout_marginBottom="10dp"/>

        <!-- Dismiss -->
        <TextView
            android:id="@+id/btnPopupDismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dismiss"
            android:textColor="#55FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="10dp"
            android:background="?attr/selectableItemBackground"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>